# Copy to .env and fill in before running `docker compose up --build`.

# Mongo (root credentials used by the mongo container)
MONGO_USER=admin
MONGO_PASSWORD=changeme

# RabbitMQ (used by auth <-> notification queue)
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Shared across auth, ai-orchestration, sandbox-server
JWT_SECRET=

# auth (Sign in with Google) and notification (Gmail sending via nodemailer)
# are kept as separate vars here even if you point them at the same OAuth
# client — they need different redirect URIs configured in Google Cloud
# Console either way.
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
NOTIFICATION_GOOGLE_CLIENT_ID=
NOTIFICATION_GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
EMAIL_USER=

# Deliberately not set here — auth's cookie only sets `secure`/`domain` when
# COOKIE_DOMAIN is present, and that combination doesn't work over plain
# HTTP on localhost. Leave unset for local/compose dev.
# COOKIE_DOMAIN=.cryboy.in

# ai-orchestration (LangChain agent model)
MISTRAL_API_KEY=
