FROM oven/bun:1 AS base
WORKDIR /workspace

# Prune the monorepo down to just this app, so later layers don't depend on
# unrelated apps' files.
FROM base AS pruner
COPY . .
RUN bunx turbo prune @repo/sandbox-template --docker

# Install deps from the pruned lockfile/package.jsons only — this layer is
# cached across builds unless a dependency actually changes, so editing
# app source no longer forces a full reinstall.
FROM base AS installer
COPY --from=pruner /workspace/out/json/ .
RUN bun install --frozen-lockfile

FROM base AS runtime
# Copy everything installer produced (bun nests some deps under each
# workspace's own node_modules rather than hoisting all of them to the
# root), then overlay the real source on top.
COPY --from=installer /workspace ./
COPY --from=pruner /workspace/out/full/ .

EXPOSE 5173

CMD ["bun", "--filter", "@repo/sandbox-template", "dev"]
