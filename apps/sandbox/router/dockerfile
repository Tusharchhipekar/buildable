FROM oven/bun:1 AS base
WORKDIR /app
FROM base AS pruner
COPY . .
RUN bunx turbo prune @repo/router --docker


FROM node:22-slim AS installer
WORKDIR /app
COPY --from=pruner /app/out/json/ .

RUN node -e "const fs=require('fs');const p=JSON.parse(fs.readFileSync('package.json'));delete p.devEngines;fs.writeFileSync('package.json',JSON.stringify(p,null,2));"
RUN npm install

FROM node:22-slim AS runtime
WORKDIR /app

COPY --from=installer /app ./
COPY --from=pruner /app/out/full/ .

EXPOSE 3000


CMD [ "node_modules/.bin/tsx", "apps/sandbox/router/src/index.ts" ]
