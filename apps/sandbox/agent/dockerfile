FROM oven/bun:1 AS base
WORKDIR /app

FROM base AS pruner
COPY . .
RUN bunx turbo prune @repo/agent --docker



FROM node:22-slim AS installer
WORKDIR /app
RUN apt-get update && apt-get install -y \
    python3 \
    make \
    g++ \
    && rm -rf /var/lib/apt/lists/*
COPY --from=pruner /app/out/json/ .

RUN node -e "const fs=require('fs');const p=JSON.parse(fs.readFileSync('package.json'));delete p.devEngines;fs.writeFileSync('package.json',JSON.stringify(p,null,2));"
RUN npm install

FROM node:22-slim AS runtime
WORKDIR /app

COPY --from=installer /app ./
COPY --from=pruner /app/out/full/ .

RUN mkdir /workspace

EXPOSE 3000

CMD [ "node_modules/.bin/tsx", "apps/sandbox/agent/src/index.ts" ]
