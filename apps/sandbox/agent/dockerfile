FROM oven/bun:1 AS base
WORKDIR /app

# Prune the monorepo down to just this app + the workspace packages it
# depends on, so later layers don't depend on unrelated apps' files.
FROM base AS pruner
COPY . .
RUN bunx turbo prune @repo/agent --docker

# Install deps from the pruned lockfile/package.jsons only — this layer is
# cached across builds unless a dependency actually changes, so editing
# app source no longer forces a full reinstall.
#
# 'make', 'g++', and 'python3' are required for node-gyp to compile
# node-pty's native addon. They're only needed here in the install stage —
# the compiled binary runs fine in the runtime stage without them.
FROM base AS installer
RUN apt-get update && apt-get install -y \
    python3 \
    make \
    g++ \
    && rm -rf /var/lib/apt/lists/*
COPY --from=pruner /app/out/json/ .
RUN bun install --frozen-lockfile

FROM base AS runtime
# Copy everything installer produced (bun nests some deps under each
# workspace's own node_modules rather than hoisting all of them to the
# root), then overlay the real source on top.
COPY --from=installer /app ./
COPY --from=pruner /app/out/full/ .

RUN mkdir /workspace

EXPOSE 3000

CMD [ "bun", "apps/sandbox/agent/src/index.ts" ]
